import { useState } from "react";
import { Button, Input, Card, Page, Text, Box } from "@wix/react";
import { createUser, getUser, updateUser } from "@wix/data";
import { sendEmail } from "@wix/email";

export function App() {
  const [user, setUser] = useState(null);
  const [page, setPage] = useState("home");

  return (
    <Page>
      {page === "home" && <Home setPage={setPage} />}
      {page === "login" && <Login setPage={setPage} setUser={setUser} />}
      {page === "register" && <Register setPage={setPage} />}
      {page === "dashboard" && <Dashboard user={user} setPage={setPage} setUser={setUser} />}
      {page === "cotizacion" && <Cotizacion user={user} setPage={setPage} />}
      {page === "admin" && <AdminPanel />}
    </Page>
  );
}

